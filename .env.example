APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# AWS Cognito (추후 설정)
# AWS_REGION=ap-northeast-2
# COGNITO_USER_POOL_ID=
# COGNITO_BACKEND_CLIENT_ID=
# COGNITO_BACKEND_CLIENT_SECRET=

# 관측 — 로깅 (app/core/logging_config.py)
# stdout JSON 구조화 로그 -> Grafana Alloy -> Loki.
# 로컬에서 사람이 읽는 형식으로 보려면 LOG_FORMAT=text 로 둔다.
LOG_LEVEL=INFO
LOG_FORMAT=text

# 관측 — 분산 추적 (app/core/tracing.py)
# OTEL_EXPORTER_OTLP_ENDPOINT 가 비어 있으면 tracing 자체가 켜지지
# 않는다(로컬 개발/테스트 기본값). collector 를 띄워 확인하려면 아래
# 주석을 풀고 실제 주소를 넣는다. exporter 는 OTLP http/protobuf 이므로
# 포트는 4317(gRPC)이 아니라 4318 이다.
OTEL_SERVICE_NAME=backend-auth
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local

# Database
# 배포 환경(dev/prod)의 데이터베이스 이름은 dpyb_auth 로 고정이다.
# 로컬 개발은 아무 이름이나 써도 된다. docs/db-per-service.md 참고.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
